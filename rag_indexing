turn out\n\ndef clean(word):\n    return re.sub(r'\\s+', ' ', word.replace(' ##', '').replace('##', '')).strip(' ,.')\n\n# Gộp 'tên' vào 'Họ tên' nếu cùng loại và là phần cuối của tên dài\ndef merge_aliases(ents):\n    merged = {}\n    for (name, typ), cnt in sorted(ents.items(), key=lambda x: -len(x[0][0])):\n        target = next(\n            (k for k in merged if k[1] == typ and k[0].endswith(' ' + name)), None)\n        if target:\n            merged[target] += cnt\n        else:\n            merged[(name, typ)] = cnt\n    return merged\n\ndef ner_article(text, min_score=0.6, drop_misc=False):\n    wins = windows(text)\n    ents = Counter()\n    for win, res in zip(wins, ner(wins, batch_size=16)):\n        for e in res:\n            name = win[e['start']:e['end']].strip(' ,.') # lấy từ văn bản gốc\n            typ = e['entity_group']\n            if e['score'] < min_score or len(name) < 2:\n                continue\n            if drop_misc and typ == 'MISCELLANEOUS':\n                continue\n            ents[(name, typ)] += 1\n\n    grouped = defaultdict(list)\n    for (name, typ), cnt in sorted(merge_aliases(ents).items(), key=lambda x: -x[1]):\n        grouped[typ].append(name)\n    return dict(grouped)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-06T07:39:37.480339Z","iopub.execute_input":"2026-10-06T07:39:37.480706Z","iopub.status.idle":"2026-10-06T07:39:39.911635Z","shell.execute_reply.started":"2026-10-06T07:39:37.480637Z","shell.execute_reply":"2026-10-06T07:39:39.910957Z"}},"outputs":[{"name":"stderr","text":"Device set to use cuda:0\n","output_type":"stream"}],"execution_count":9},{"cell_type":"code","source":"# mx = max(len(tokenizer.encode(w)) for d in articles[:2000] for w in windows(d.page_content))\n# print('cửa sổ dài nhất:', mx) # phải ≤ 512","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-06T07:49:50.873951Z","iopub.execute_input":"2026-10-06T07:49:50.874324Z","iopub.status.idle":"2026-10-06T07:5