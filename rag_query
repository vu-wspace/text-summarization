batch(queries, k=20, top_n=5, use_rerank=True):\n        if not queries:\n            return []\n\n        candidates = _search(queries, k)\n        if not use_rerank:\n            return [c[:top_n] for c in candidates]\n        return rerank_batch(queries, candidates, top_n=top_n)\n        \n    def retrieve(query, k=20, top_n=5, use_rerank=True):\n        return retrieve_batch([query], k=k, top_n=top_n, use_rerank=True)[0]\n    return retrieve, retrieve_batch","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-01T09:36:01.079841Z","iopub.execute_input":"2026-10-01T09:36:01.080159Z","iopub.status.idle":"2026-10-01T09:36:01.093189Z","shell.execute_reply.started":"2026-10-01T09:36:01.080126Z","shell.execute_reply":"2026-10-01T09:36:01.092574Z"}},"outputs":[],"execution_count":50},{"cell_type":"markdown","source":"## [BAAI/bge-reranker-v2-m3](https://huggingface.co/BAAI/bge-reranker-v2-m3)","metadata":{}},{"cell_type":"code","source":"import torch\nfrom sentence_transformers import CrossEncoder","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-01T09:36:01.09402Z","iopub.execute_input":"2026-10-01T09:36:01.094355Z","iopub.status.idle":"2026-10-01T09:36:01.115534Z","shell.execute_reply.started":"2026-10-01T09:36:01.094309Z","shell.execute_reply":"2026-10-01T09:36:01.11479Z"}},"outputs":[],"execution_count":51},{"cell_type":"code","source":"_reranker = None\ndef get_reranker():\n    global _reranker\n    if _reranker is None:\n        _reranker = CrossEncoder('BAAI/bge-reranker-v2-m3')\n    return _reranker\n    \ndef rerank_batch(queries, candidates, top_n=5, batch_size=64):\n    pairs, owner, flat = [], [], []\n    for qi, (q, cands) in enumerate(zip(queries, candidates)):\n        for c in cands:\n            pairs.append([q, c.page_content])\n            owner.append(qi)\n            flat.append(c)\n            \n    if not pairs:\n        return [[] for _ in queries]\n\n    scores = get_reranker().predict(pairs, batch_size=batch