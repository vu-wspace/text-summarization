ype":"code","source":"PATH_FAISS = '/kaggle/input/datasets/vuwspace/batch23bd/faiss_index'\n\nPATH_CHUNKS = os.path.join(PATH_FAISS, 'chunks.pkl')\nPATH_EMBEDDS = os.path.join(PATH_FAISS, 'embedds.npy')\nPATH_INDEX = os.path.join(PATH_FAISS, 'index.faiss')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-01T08:33:48.937571Z","iopub.execute_input":"2026-10-01T08:33:48.937897Z","iopub.status.idle":"2026-10-01T08:33:48.949135Z","shell.execute_reply.started":"2026-10-01T08:33:48.937862Z","shell.execute_reply":"2026-10-01T08:33:48.94839Z"}},"outputs":[],"execution_count":47},{"cell_type":"code","source":"from FlagEmbedding import BGEM3FlagModel\nimport faiss","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-01T08:33:48.949974Z","iopub.execute_input":"2026-10-01T08:33:48.950309Z","iopub.status.idle":"2026-10-01T08:33:48.965571Z","shell.execute_reply.started":"2026-10-01T08:33:48.950277Z","shell.execute_reply":"2026-10-01T08:33:48.964777Z"}},"outputs":[],"execution_count":48},{"cell_type":"code","source":"def get_chunks():\n    with open(PATH_CHUNKS, 'rb') as f:\n        return pickle.load(f)\n\ndef bge_m3_embedds():\n    return BGEM3FlagModel('BAAI/bge-m3', use_fp16=True)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-01T08:33:48.966362Z","iopub.execute_input":"2026-10-01T08:33:48.9666Z","iopub.status.idle":"2026-10-01T08:33:48.978647Z","shell.execute_reply.started":"2026-10-01T08:33:48.966578Z","shell.execute_reply":"2026-10-01T08:33:48.977952Z"}},"outputs":[],"execution_count":49},{"cell_type":"code","source":"def retriever(idx, chunks, bge_m3_embedds, q_max_length=512):\n    def _search(queries, k):\n        vecs = bge_m3_embedds.encode(queries, batch_size=32, max_length=q_max_length)['dense_vecs']\n        vecs = np.asarray(vecs, dtype='float32')\n        \n        faiss.normalize_L2(vecs)\n        _, I = idx.search(vecs, k)\n        return [[chunks[j] for j in row if j != -1] for row in I]\n\n    def retrieve_batch(queries, k=20, top_n=5, use_rerank=True):\n        if not queries:\n            return []\n\n        candidates = _search(queries, k)\n        if not use_rerank:\n            return [c[:top_n] for c in candidates]\n        return rerank_batch(queries, candidates, top_n=top_n)\n        \n    def retrieve(query, k=20, top_n=5, use_rerank=True):\n        return retrieve_batch([query], k=k, top_n=top_n, use_rerank=True)[0]\n    return retrieve, retrieve_batch","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-01T08:33:48.979532Z","iopub.execute_input":"2026-10-01T08:33:48.979818Z","iopub.status.idle":"2026-10-01T08:33:48.991756Z","shell.execute_reply.started":"2026-10-01T08:33:48.979783Z","shell.execute_reply":"2026-10-01T08:33:48.990961Z"}},"outputs":[],"execution_count":50},{"cell_type":"markdown","source":"## [BAAI/bge-reranker-v2-m3](https://huggingface.co/BAAI/bge-reranker-v2-m3)","metadata":{}},{"cell_type":"code","source":"import torch\nfrom sentence_transformers import CrossEncoder","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-01T08:33:48.994563Z","iopub.execute_input":"2026-10-01T08:33:48.994975Z","iopub.status.idle":"2026-10-01T08:33:49.008931Z","shell.execute_reply.started":"2026-10-01T08:33:48.994951Z","shell.execute_reply":"2026-10-01T08:33:49.008212Z"}},"outputs":[],"execution_count":51},{"cell_type":"code","source":"_reranker = None\ndef get_reranker():\n    global _reranker\n    if _reranker is None:\n        _reranker = CrossEncoder('BAAI/bge-reranker-v2-m3')\n    return _reranker\n    \ndef rerank_batch(articles, candidates, top_n=5, batch_size=64):\n    pairs, owner, flat = [], [], []\n    for qi, (q, cands) in enumerate(zip(queries, candidates)):\n        for c in cands:\n            pairs.append([q, c.page_content])\n            owner.append(qi)\n            flat.append(c)\n            \n    if not pairs:\n        return [[] for _ in queries]\n\n    scores = get_reranker().predict(pairs, batch_s