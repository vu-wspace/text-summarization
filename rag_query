    text = re.sub(r'\"\\s*(.*?)\\s*\"', r'\"\\1\"', text)\n    text = re.sub(r'\\s+/\\s+', '/', text)\n    return re.sub(r'\\s+', ' ', text).strip()\n\ndef normalize_query(q):\n    # Câu hỏi người dùng: không bỏ caption, KHÔNG lower()\n    return normalize_text(q, drop_caption=False)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-01T08:33:47.703257Z","iopub.execute_input":"2026-10-01T08:33:47.70363Z","iopub.status.idle":"2026-10-01T08:33:47.722089Z","shell.execute_reply.started":"2026-10-01T08:33:47.703584Z","shell.execute_reply":"2026-10-01T08:33:47.721296Z"}},"outputs":[],"execution_count":40},{"cell_type":"markdown","source":"# Querying","metadata":{}},{"cell_type":"code","source":"import json\nimport random\nfrom pathlib import Path\nfrom langchain_core.documents import Document","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-01T08:33:47.723036Z","iopub.execute_input":"2026-10-01T08:33:47.723339Z","iopub.status.idle":"2026-10-01T08:33:47.735703Z","shell.execute_reply.started":"2026-10-01T08:33:47.723316Z","shell.execute_reply":"2026-10-01T08:33:47.734996Z"}},"outputs":[],"execution_count":41},{"cell_type":"code","source":"PATH_ARTICLE = '/kaggle/input/datasets/vuwspace/batch23bd/text_summarization/load/data_article.json'\nOUTPUT = '/kaggle/working/'","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-01T08:33:47.737763Z","iopub.execute_input":"2026-10-01T08:33:47.738082Z","iopub.status.idle":"2026-10-01T08:33:47.748195Z","shell.execute_reply.started":"2026-10-01T08:33:47.738059Z","shell.execute_reply":"2026-10-01T08:33:47.747486Z"}},"outputs":[],"execution_count":42},{"cell_type":"code","source":"with open(PATH_ARTICLE, 'r', encoding='utf-8') as f:\n        data = json.load(f)\n        \narticles = [\n    Document(\n        page_content = v['article'],\n        metadata = {\n            'guid': k,\n            'title': v['title'],\n            'abstract': v['abstract'],\n        }, id=k\n    ) for k,