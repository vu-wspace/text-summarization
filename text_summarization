, None)\n    \n    if n == 1 or sim.sum() == 0:\n        return np.linspace(1, 0, n), sim\n    try:\n        pr = nx.pagerank(nx.from_numpy_array(sim), max_iter=200)\n        return np.array([pr[i] for i in range(n)]), sim\n    except nx.PowerIterationFailedConvergence:\n        return np.linspace(1, 0, n), sim","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T07:06:01.59898Z","iopub.execute_input":"2026-09-25T07:06:01.59958Z","iopub.status.idle":"2026-09-25T07:06:01.608808Z","shell.execute_reply.started":"2026-09-25T07:06:01.599544Z","shell.execute_reply":"2026-09-25T07:06:01.607935Z"}},"outputs":[],"execution_count":31},{"cell_type":"code","source":"with open(os.path.join(out_dir, 'train.json'), encoding='utf-8') as f:\n    data_train = json.load(f)\n\ntrain_len = pd.Series([len(to_syllable(v['abstract']).split()) for v in data_train.values()])\nprint(train_len.describe(percentiles=[.25, .5, .75]).round(1))\n\nBUDGET = int(train_len.median())\nprint('BUDGET =', BUDGET)\n\ndel data_train","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T07:06:01.609762Z","iopub.execute_input":"2026-09-25T07:06:01.61012Z","iopub.status.idle":"2026-09-25T07:06:06.690301Z","shell.execute_reply.started":"2026-09-25T07:06:01.61008Z","shell.execute_reply":"2026-09-25T07:06:06.689359Z"}},"outputs":[{"name":"stdout","text":"count    99000.0\nmean        37.3\nstd         10.8\nmin          8.0\n25%         30.0\n50%         35.0\n75%         44.0\nmax        159.0\ndtype: float64\nBUDGET = 35\n","output_type":"stream"}],"execution_count":32},{"cell_type":"code","source":"BUDGET = 35","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T07:06:06.691333Z","iopub.execute_input":"2026-09-25T07:06:06.691593Z","iopub.status.idle":"2026-09-25T07:06:06.696217Z","shell.execute_reply.started":"2026-09-25T07:06:06.69157Z","shell.execute_reply":"2026-09-25T07:06:06.695376Z"}},"outputs":[],"execution_count":33},{"cell_type":"code","source