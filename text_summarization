ly.started":"2026-10-06T10:19:30.685911Z","shell.execute_reply":"2026-10-06T10:19:30.699543Z"}},"outputs":[],"execution_count":32},{"cell_type":"code","source":"def format_entities(ents):\n    if not ents:\n        return 'Không tìm thấy thực thể nào trong bài.'\n    return '\\n'.join(f'  {LABELS.get(t, t)}: {\", \".join(names)}'\n                     for t, names in ents.items())\n\ndef wanted_types(payload):\n    p = payload.lower()\n    hit = [t for t, ws in TYPE_WORDS.items() if any(w in p for w in ws)]\n    return hit or None # None = lấy hết","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-06T10:19:30.701196Z","iopub.execute_input":"2026-10-06T10:19:30.701489Z","iopub.status.idle":"2026-10-06T10:19:30.716851Z","shell.execute_reply.started":"2026-10-06T10:19:30.701459Z","shell.execute_reply":"2026-10-06T10:19:30.716232Z"}},"outputs":[],"execution_count":33},{"cell_type":"code","source":"with open(os.path.join(PATH, 'entities.json'), encoding='utf-8') as f:\n    entities = json.load(f)\n\ndef route(message, min_text_len=300):\n    msg = unicodedata.normalize('NFC', message).strip()\n    list_ent = LIST_RE.match(msg)\n    if list_ent:\n        return 'list', msg[list_ent.end():].strip()\n    \n    summ_text = SUM_RE.match(msg)\n    if summ_text:\n        rest = msg[summ_text.end():].strip()\n        return ('summarize_text' if len(rest) >= min_text_len else 'summarize_topic'), rest\n    return 'qa', msg\n    \ndef handle(message):\n    intent, payload = route(message)\n\n    if intent == 'qa':\n        ans, docs = answer(payload)\n        return intent, ans, docs\n\n    if intent == 'list':\n        topic = TYPE_STRIP.sub('', payload).strip() or payload\n        docs = r(normalize_query(topic), k=20, top_n=1, use_rerank=True)\n        if not docs:\n            return intent, 'Không tìm thấy bài báo phù hợp.', []\n    \n        g = docs[0].metadata['guid']                                  # 1. lấy guid TRƯỚC\n        ents = entities.get(g, {})                                    # 2. tra thực thể của đúng bài đó\n    \n        types = wanted_types(payload)                                 # 3. lọc theo loại (nếu có)\n        if types:\n            ents = {t: v for t, v in ents.items() if t in types}\n\n        title = data[g]['title']\n        return intent, f'Bài: {title}\\n{format_entities(ents)}', docs # 4. dùng ents đã lọc\n\n    if intent == 'summarize_text':\n        return intent, summarize(normalize_text(payload, drop_caption=False)), []\n\n    # retriever lấy 20 chunk → re-ranker sắp xếp → chunk top-1 chỉ ra bài liên quan nhất\n    docs = r(normalize_query(payload), k=20, top_n=5)\n    if not docs:\n        return intent, 'Không tìm thấy bài báo phù hợp.', []\n        \n    g = docs[0].metadata['guid']                            # bài chứa chunk top-1\n    return intent, summarize(data[g]['article']), [docs[0]] # tóm tắt NGUYÊN BÀI, không phải chunk\n\ndef router(show_sources=True):\n    print('Sẵn sàng. Gõ \"exit\" để thoát.\\n')\n    \n    while True:\n        message = input('Bạn: ').strip()\n        if message.lower() == 'exit':\n            break\n            \n        if not message:\n            continue\n\n        intent, out, docs = handle(message)\n        label = 'Tóm tắt' if intent.startswith('summarize') else 'Trả lời'\n        print(f'\\n[{intent}] {label}: {out}')\n\n        if show_sources and docs:\n            seen = set()\n            for d in docs:\n                g = d.metadata['guid']\n                if g not in seen:\n                    seen.add(g)\n                    print(f\"  - [{g}] {data[g]['title']}\")\n                    \n                if len(seen) == 3:\n                    break\n        print()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-06T10:19:30.717765Z","iopub.execute_input":"2026-10-06T10:19:30.718054Z","iopub.status.idle":"2026-10-06T10:19:31.019136Z","shell.execute_reply.started":"2026-10-06T10:19:30.718033Z","shell.execute