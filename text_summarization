NG có '_')\ndef load_split(name, ids=None, limit=None, seed=SEED):\n    with open(os.path.join(OUT_DIR, f'{name}.json'), encoding='utf-8') as f:\n        data = json.load(f)\n    keys = ids if ids is not None else sorted(data.keys())\n    if limit and ids is None:\n        keys = random.Random(seed).sample(keys, min(limit, len(keys)))\n    return Dataset.from_list([{\n        'id': k,\n        'document': to_syllable(data[k]['article']),\n        'summary':  to_syllable(data[k]['abstract']),\n    } for k in keys])\n\neval_ids = json.load(open(os.path.join(OUT_DIR, 'eval_ids.json')))\ntrain_ds = load_split('train', limit=MAX_TRAIN)\n\n# Tập nhỏ để chọn checkpoint: lấy từ val nhưng KHÔNG trùng với 2000 bài eval_ids\nwith open(os.path.join(OUT_DIR, 'val.json'), encoding='utf-8') as f:\n    _val_keys = sorted(json.load(f).keys())\n    \n_pool = sorted(set(_val_keys) - set(eval_ids))\ndev_ids = random.Random(SEED).sample(_pool, N_EVAL_TRAIN)\ndev_ds  = load_split('val', ids=dev_ids)\n\nprint(train_ds, dev_ds)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T07:08:15.790872Z","iopub.execute_input":"2026-09-25T07:08:15.791384Z","iopub.status.idle":"2026-09-25T07:08:23.948387Z","shell.execute_reply.started":"2026-09-25T07:08:15.79135Z","shell.execute_reply":"2026-09-25T07:08:23.947674Z"}},"outputs":[{"name":"stdout","text":"Dataset({\n    features: ['id', 'document', 'summary'],\n    num_rows: 30000\n}) Dataset({\n    features: ['id', 'document', 'summary'],\n    num_rows: 300\n})\n","output_type":"stream"}],"execution_count":63},{"cell_type":"code","source":"# Chọn độ dài token từ TẬP TRAIN\ntokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)\nsample = train_ds.shuffle(seed=SEED).select(range(min(3000, len(train_ds))))\nsrc_len = np.array([len(tokenizer(x).input_ids) for x in sample['document']])\ntgt_len = np.array([len(tokenizer(x).input_ids) for x in sample['summary']])\n\nprint(f'Bài  : trung vị {np.median(src_len):.0f}, P95 {np.percentile(src