l},{"cell_type":"code","source":"NO_ANSWER = 'Tôi không biết dựa trên các tài liệu được cung cấp.'\n\nSYSTEM_PROMPT = (\n    'Bạn là trợ lý hỏi đáp tin tức tiếng Việt.\\n'\n    'QUY TẮC:\\n'\n    '1. CHỈ dùng thông tin trong NGỮ CẢNH để trả lời. Không dùng kiến thức bên ngoài, không suy đoán.\\n'\n    f'2. Nếu ngữ cảnh không có câu trả lời, chỉ trả lời đúng câu: \"{NO_ANSWER}\"\\n'\n    '3. Luôn trả lời bằng tiếng Việt, không mở đầu, không lặp lại câu hỏi, không giải thích cách làm.\\n'\n    '4. Trả lời ngắn gọn, giữ nguyên tên riêng, con số, ngày tháng như trong ngữ cảnh.'\n)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def build_context(docs, tok, budget=2500):\n    parts, used = [], 0\n    for i, d in enumerate(docs, 1):\n        text = d.page_content if hasattr(d, 'page_content') else str(d)\n        n = len(tok.encode(text, add_special_tokens=False))\n        if used + n > budget:\n            break\n        parts.append(f'[{i}] {text}')\n        used += n\n    return '\\n\\n'.join(parts)\n\n@torch.no_grad()\ndef generate_batch(questions, contexts, max_new_tokens=256):\n    texts = [\n        llm_tok.apply_chat_template(\n            [{'role': 'system', 'content': SYSTEM_PROMPT},\n             {'role': 'user', 'content': f'NGỮ CẢNH:\\n{c}\\n\\nCÂU HỎI: {q}'}],\n            tokenize=False, add_generation_prompt=True)\n        for q, c in zip(questions, contexts)\n    ]\n    inputs = llm_tok(texts, return_tensors='pt', padding=True).to(llm.device)\n    out = llm.generate(\n        **inputs,\n        max_new_tokens=max_new_tokens,\n        do_sample=False,\n        repetition_penalty=1.05,\n        pad_token_id=llm_tok.pad_token_id,\n    )\n    new = out[:, inputs['input_ids'].shape[1]:] # left padding → cắt chung một vị trí\n    return [t.strip() for t in llm_tok.batch_decode(new, skip_special_tokens=True)]","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def expand_to_articles(docs, max_articles=3):\n    seen, out = set(), []\n    for d in docs:\n        g = d.metadata['guid']\n        if g in seen:\n            continue\n        seen.add(g)\n        out.append(Document(\n            page_content=f\"{data[g]['title']} . {data[g]['article']}\",\n            metadata=d.metadata,\n        ))\n        if len(out) == max_articles:\n            break\n    return out\n\ndef answer(question, k=20, top_n=10, n_articles=3, use_rerank=True):\n    q = normalize_query(question)\n    docs = r(q, k=k, top_n=top_n, use_rerank=use_rerank)\n    arts = expand_to_articles(docs, n_articles)\n    return generate_batch([q], [build_context(arts, llm_tok, budget=3000)])[0], arts","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# Router","metadata":{}},{"cell_type":"markdown","source":"## Summarization","metadata":{}},{"cell_type":"code","source":"# import time","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# with open(os.path.join(PATH, 'data_test.json'), encoding='utf-8') as f:\n#     data_test = json.load(f)\n\n# # Sắp theo độ dài bài: các bài trong cùng batch dài tương đương nhau → ít padding → chạy nhanh hơn\n# test_ids = sorted(data_test.keys(), key=lambda i: len(data_test[i]['article']))\n\n# PART = os.path.join(OUTPUT, 'vit5_large_test.partial.jsonl')\n\n# # Nếu có file partial từ phiên trước (đã Add Input), chép về working để chạy tiếp\n# if not os.path.exists(PART):\n#     for d, _, files in os.walk('/kaggle/input'):\n#         if 'vit5_large_test.partial.jsonl' in files:\n#             with open(os.path.join(d, 'vit5_large_test.partial.jsonl'), encoding='utf-8') as src, \\\n#                  open(PART, 'w', encoding='utf-8') as dst:\n#                 dst.write(src.read())\n#             break\n\n# done = set()\n# if os.path.exists(PART) and os.path.getsize(PART) > 0:\n#     done = set(pd.read_json(PART, lines=True, dtype={'id': str})['id'])\