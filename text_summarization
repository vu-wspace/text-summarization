ub(fix_plate, text)\n    text = re.sub(r'\\bv\\s*\\.\\s*v\\s*\\.?', 'v.v.', text)\n    text = re.sub(rf'\\b({ABBR})\\s+\\.(?=\\s)', r'\\1.', text)\n    text = re.sub(rf'\\s\\.\\s(?={LOWER_CLS})', '. ', text)\n    text = re.sub(r'\"\\s*(.*?)\\s*\"', r'\"\\1\"', text)\n    text = re.sub(r'\\s+/\\s+', '/', text)\n    return re.sub(r'\\s+', ' ', text).strip()\n\ndef normalize_query(q):\n    # Câu hỏi người dùng: không bỏ caption, KHÔNG lower()\n    return normalize_text(q, drop_caption=False)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# Querying","metadata":{}},{"cell_type":"code","source":"import random\nfrom pathlib import Path\nfrom langchain_core.documents import Document","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"PATH_ARTICLE = '/kaggle/input/datasets/vuwspace/batch23bd/text_summarization/load/data_article.json'","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"with open(PATH_ARTICLE, 'r', encoding='utf-8') as f:\n        data = json.load(f)\n        \narticles = [\n    Document(\n        page_content = v['article'],\n        metadata = {\n            'guid': k,\n            'title': v['title'],\n            'abstract': v['abstract'],\n        }, id=k\n    ) for k, v in data.items()\n]\n\nprint(f'{len(data)} bài báo.')","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"SEED = 42\nPATH_SAMPLE = os.path.join(OUTPUT, 'data_article_sample.json')","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Lấy ngẫu nhiên 2000 bài báo\nrandom.seed(SEED)\neval_ids = random.sample(list(data), k=2000)\nsample = {g: data[g] for g in eval_ids}\n\nwith open(PATH_SAMPLE, 'w', encoding='utf-8') as f:\n    json.dump(sample, f, ensure_ascii=False)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Retriever","metadata":{}},{"cell_type":"code","source":"import pickle\nimport faiss","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"PATH_FAISS = '/kaggle/input/datasets/vuwspace/batch23bd/faiss_index'\n\nPATH_CHUNKS = os.path.join(PATH_FAISS, 'chunks.pkl')\nPATH_EMBEDDS = os.path.join(PATH_FAISS, 'embedds.npy')\nPATH_INDEX = os.path.join(PATH_FAISS, 'index.faiss')","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from FlagEmbedding import BGEM3FlagModel","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def get_chunks():\n    with open(PATH_CHUNKS, 'rb') as f:\n        return pickle.load(f)\n\ndef bge_m3_embedds():\n    return BGEM3FlagModel('BAAI/bge-m3', use_fp16=True)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def retriever(idx, chunks, bge_m3_embedds, q_max_length=512):\n    def _search(queries, k):\n        vecs = bge_m3_embedds.encode(queries, batch_size=32, max_length=q_max_length)['dense_vecs']\n        vecs = np.asarray(vecs, dtype='float32')\n        \n        faiss.normalize_L2(vecs)\n        _, I = idx.search(vecs, k)\n        return [[chunks[j] for j in row if j != -1] for row in I]\n\n    def retrieve_batch(queries, k=20, top_n=5, use_rerank=True):\n        if not queries:\n            return []\n\n        candidates = _search(queries, k)\n        if not use_rerank:\n            return [c[:top_n] for c in candidates]\n        return rerank_batch(queries, candidates, top_n=top_n)\n        \n    def retrieve(query, k=20, top_n=5, use_rerank=True):\n        return retrieve_batch([query], k=k, top_n=top_n, use_rerank=True)[0]\n    return retrieve, retrieve_batch","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## [BAAI/bge-reranker-v2-m3](https://huggingface.co/BAAI/bge-reranker-v2-m3)","metadata":{}},{"cell_type":"code","source":"from sentence_transformers import CrossEncoder","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"_reranker = None\ndef get_reranker():\n    global _reranker\n    if _reranker is None:\n        _reranker = CrossEncoder('BAAI/bge-reranker-v2-m3')\n    return _reranker\n    \ndef rerank_batch(queries, candidates, top_n=5, batch_size=64):\n    pairs, owner, flat = [], [], []\n    for qi, (q, cands) in enumerate(zip(queries, candidates)):\n        for c in cands:\n            pairs.append([q, c.page_content])\n            owner.append(qi)\n            flat.append(c)\n            \n    if not pairs:\n        return [[] for _ in queries]\n\n    scores = get_reranker().predict(pairs, batch_size=batch_size, show_progress_bar=False)\n    grouped = [[] for _ in queries]\n    \n    for qi, c, s in zip(owner, flat, scores):\n        grouped[qi].append((c, float(s)))\n    return [[c for c, _ in sorted(g, key=lambda x: x[1], reverse=True)[:top_n]] for g in grouped]\n\ndef rerank(query, candidates, top_n=5):\n    return rerank_batch([query], [candidates], top_n=top_n)[0]","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Recall@k, MMR","metadata":{}},{"cell_type":"code","source":"def get_guid(c):\n    return c.metadata['guid'] if hasattr(c, 'metadata') else c['guid']\n\ndef rank_of(gold, guids):\n    return guids.index(gold) + 1 if gold in guids else None\n\ndef evaluate(retrieve_batch, queries, gold_guids, k=20, top_n=5, batch_size=256):\n    rows = []\n    for i in range(0, len(queries), batch_size):\n        qs, gs = queries[i:i + batch_size], gold_guids[i:i + batch_size]\n        cands = retrieve_batch(qs, k=k, top_n=k, use_rerank=False)\n        rr = rerank_batch(qs, cands, top_n=top_n)\n        for q, g, c, r in zip(qs, gs, cands, rr):\n            gc, gr = [get_guid(x) for x in c], [get_guid(x) for x in r]\n            rows.append({\n                'query': q, 'gold': g,\n                f'rank_ret@{k}':      rank_of(g, gc),\n                f'rank_base@{top_n}': rank_of(g, gc[:top_n]),\n                f'rank_rr@{top_n}':   rank_of(g, gr),\n            })\n    return pd.DataFrame(rows)\n\ndef summarize(res):\n    for col in [c for c in res.columns if c.startswith('rank_')]:\n        hit = res[col].notna()\n        mrr = res[col].map(lambda r: 1 / r if pd.notna(r) else 0)\n        print(f'{col:15s} Recall={hit.mean():.3f}  MRR={mrr.mean():.3f}')","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"idx = faiss.read_index(PATH_INDEX)\nchunks = get_chunks()\nmodel_embedds = bge_m3_embedds()","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"r, r_batch = retriever(idx, chunks, model_embedds)\n\nqueries = [normalize_query(data[g]['abstract']) for g in eval_ids]\ngolds = eval_ids\n\nres = evaluate(r_batch, queries, golds, k=20, top_n=5)\nsummarize(res)\n\nres.to_csv(os.path.join(OUTPUT, 'retriever_eval.csv'), index=False)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Contexts","metadata":{}},{"cell_type":"code","source":"PATH_CONTEXTS = '/kaggle/working/contexts.json'","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def _save_atomic(obj, path):\n    tmp = path + '.tmp'\n    with open(tmp, 'w', encoding='utf-8') as f:\n        json.dump(obj, f, ensure_ascii=False)\n    os.replace(tmp, path)\n    \ndef contexts(ids, r_batch, query_fn, path_output=PATH_CONTEXTS,\n             k=20, top_n=5, use_rerank=True, batch_size=32, save_every=10):\n    existing = {}\n    if os.path.exists(path_output):\n        with open(path_output, encoding='utf-8') as f:\n            existing = json.load(f)\n            \n    p_ids = [g for g in ids if g not in existing]\n    if not p_ids:\n        print('Đã retrieve đủ.')\n        return existing\n    print(f'Cần re