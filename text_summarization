":"NAME = 'VietAI/vit5-large-vietnews-summarization'\ntokenizer = AutoTokenizer.from_pretrained(NAME)\nmodel = AutoModelForSeq2SeqLM.from_pretrained(NAME).to('cuda').eval() # fp32: T5 dễ lỗi NaN với fp16\n\ndef to_syllable(t):\n    return ' '.join(t.replace('_', ' ').split())\n\nclass WS:\n    def tokenize(self, t):\n        return re.findall(r'\\w+', t.lower())\n\nscorer = rouge_scorer.RougeScorer(['rouge1', 'rouge2', 'rougeL'], tokenizer=WS())\nms = ['rouge1', 'rouge2', 'rougeL']","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"MAX_SOURCE = 1024\n\n@torch.no_grad()\ndef summarize_large(texts, bs=8):\n    outs = []\n    for i in tqdm(range(0, len(texts), bs), desc='ViT5-large'):\n        batch = ['vietnews: ' + t + ' </s>' for t in texts[i:i + bs]]\n        enc = tokenizer(batch, max_length=MAX_SOURCE, truncation=True, padding=True, return_tensors='pt').to('cuda')\n        gen = model.generate(**enc, max_length=256, num_beams=4, early_stopping=True)\n        outs.extend(tokenizer.batch_decode(gen, skip_special_tokens=True, clean_up_tokenization_spaces=True))\n    return outs","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"with open(os.path.join(PATH, 'data_val.json'), encoding='utf-8') as f:\n    data_val = json.load(f)\n    \ndata_eval = json.load(open(os.path.join(PATH, 'data_eval.json')))\n\nprobe = data_eval[:50]\nrefs = [to_syllable(data_val[i]['abstract']) for i in probe]\n\nfor label, fmt in [('âm tiết', to_syllable), ('giữ _', lambda t: t)]:\n    preds = summarize_large([fmt(data_val[i]['article']) for i in probe])\n    rl = np.mean([scorer.score(r, to_syllable(p))['rougeL'].fmeasure for r, p in zip(refs, preds)]) * 100\n    print(f'{label}: ROUGE-L = {rl:.2f}')","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"FMT = to_syllable # đổi nếu cell 3 cho thấy \"giữ _\" tốt hơn\npreds = summarize_large([FMT(data_val[i]['arti