ion_minor":0,"model_id":"333a02a102c0469d9026114188190559"}},"metadata":{}}],"execution_count":65},{"cell_type":"code","source":"# Model + Trainer\nmodel = AutoModelForSeq2SeqLM.from_pretrained(MODEL_NAME)\nmodel.config.use_cache = False\nmodel.generation_config.max_new_tokens = MAX_TARGET\nmodel.generation_config.num_beams = 4\nmodel.generation_config.no_repeat_ngram_size = 3\n\ndef compute_metrics(eval_pred):\n    preds, labels = eval_pred\n    preds  = np.where(preds  != -100, preds,  tokenizer.pad_token_id)\n    labels = np.where(labels != -100, labels, tokenizer.pad_token_id)\n    dp = tokenizer.batch_decode(preds,  skip_special_tokens=True)\n    dl = tokenizer.batch_decode(labels, skip_special_tokens=True)\n    res = {m: [] for m in ['rouge1', 'rouge2', 'rougeL']}\n    for p, l in zip(dp, dl):\n        s = scorer.score(l, p)\n        for m in res:\n            res[m].append(s[m].fmeasure)\n    out = {m: round(float(np.mean(v)) * 100, 2) for m, v in res.items()}\n    out['gen_len'] = float(np.mean([len(p.split()) for p in dp]))\n    return out\n\nuse_bf16 = torch.cuda.is_available() and torch.cuda.is_bf16_supported()\nuse_fp16 = torch.cuda.is_available() and not use_bf16\nsteps_per_epoch = len(train_tok) // (BATCH * ACCUM)\ntotal_steps = steps_per_epoch * EPOCHS\nwarmup = int(0.05 * total_steps)\n\nargs = Seq2SeqTrainingArguments(\n    output_dir=CKPT_DIR,\n    per_device_train_batch_size=BATCH,\n    per_device_eval_batch_size=8,\n    gradient_accumulation_steps=ACCUM,\n    learning_rate=LR,\n    num_train_epochs=EPOCHS,\n    warmup_steps=warmup,\n    weight_decay=0.01,\n    lr_scheduler_type='linear',\n    eval_strategy='steps', eval_steps=eval_every,\n    save_strategy='steps', save_steps=eval_every, save_total_limit=2,\n    load_best_model_at_end=True, metric_for_best_model='rougeL', greater_is_better=True,\n    predict_with_generate=True,\n    bf16=use_bf16, fp16=use_fp16,\n    gradient_checkpointing=True,\n    logging_steps=50,\n    report_to='none',\n    seed=SEED,\n)\n\ntrainer = Seq2SeqTrainer(\n    model=model, args=args,\n    train_dataset=train_tok, eval_dataset=dev_tok,\n    data_collator=DataCollatorForSeq2Seq(tokenizer, model=model),\n    processing_class=tokenizer,\n    compute_metrics=compute_metrics,\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T07:10:23.871792Z","iopub.execute_input":"2026-09-25T07:10:23.872292Z","iopub.status.idle":"2026-09-25T07:10:24.763201Z","shell.execute_reply.started":"2026-09-25T07:10:23.87226Z","shell.execute_reply":"2026-09-25T07:10:24.762313Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"Loading weights:   0%|          | 0/265 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"daefe7bde01c45f89776a01dbb5eb951"}},"metadata":{}}],"execution_count":67},{"cell_type":"code","source":"# Train (tự tiếp tục nếu đã có checkpoint từ phiên trước)\nhas_ckpt = os.path.isdir(CKPT_DIR) and any(d.startswith('checkpoint-') for d in os.listdir(CKPT_DIR))\ntrainer.train(resume_from_checkpoint=True if has_ckpt else None)\n\nBEST_DIR = os.path.join(OUT_DIR, 'bartpho_best')\ntrainer.save_model(BEST_DIR)\ntokenizer.save_pretrained(BEST_DIR)\nprint('Checkpoint tốt nhất:', trainer.state.best_model_checkpoint)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T07:10:28.160256Z","iopub.execute_input":"2026-09-25T07:10:28.161017Z","iopub.status.idle":"2026-09-25T08:35:00.783146Z","shell.execute_reply.started":"2026-09-25T07:10:28.160986Z","shell.execute_reply":"2026-09-25T08:35:00.782436Z"},"collapsed":true,"jupyter":{"outputs_hidden":true}},"outputs":[{"name":"stderr","text":"/usr/local/lib/python3.12/dist-packages/torch/autograd/function.py:583: UserWarning: Was asked to gather along dimension 0, but all input tensors were scalars; will instead unsqueeze and return a vector.\n  return super().apply(*args, **kwargs)  # type: ignore[misc]\n","output_type":"stream"},{"output_t