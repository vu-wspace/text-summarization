 i in sorted(chosen))\n    \n# Chấm điểm câu bằng đồ thị + PageRank\ndef textrank(X):\n    n = X.shape[0]\n    sim = cosine_similarity(X)\n    np.fill_diagonal(sim, 0)\n    sim = np.clip(sim, 0, None)\n    \n    if n == 1 or sim.sum() == 0:\n        return np.linspace(1, 0, n), sim\n    try:\n        pr = nx.pagerank(nx.from_numpy_array(sim), max_iter=200)\n        return np.array([pr[i] for i in range(n)]), sim\n    except nx.PowerIterationFailedConvergence:\n        return np.linspace(1, 0, n), sim","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T09:56:00.902804Z","iopub.execute_input":"2026-09-25T09:56:00.903842Z","iopub.status.idle":"2026-09-25T09:56:00.91379Z","shell.execute_reply.started":"2026-09-25T09:56:00.903811Z","shell.execute_reply":"2026-09-25T09:56:00.912992Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"with open(os.path.join(out_dir, 'train.json'), encoding='utf-8') as f:\n    data_train = json.load(f)\n\ntrain_len = pd.Series([len(to_syllable(v['abstract']).split()) for v in data_train.values()])\nprint(train_len.describe(percentiles=[.25, .5, .75]).round(1))\n\nBUDGET = int(train_len.median())\nprint('BUDGET =', BUDGET)\n\ndel data_train","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T09:56:00.914673Z","iopub.execute_input":"2026-09-25T09:56:00.914996Z","iopub.status.idle":"2026-09-25T09:56:07.622966Z","shell.execute_reply.started":"2026-09-25T09:56:00.91497Z","shell.execute_reply":"2026-09-25T09:56:07.62214Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"BUDGET = 35","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T09:56:07.624015Z","iopub.execute_input":"2026-09-25T09:56:07.624334Z","iopub.status.idle":"2026-09-25T09:56:07.629205Z","shell.execute_reply.started":"2026-09-25T09:56:07.624307Z","shell.execute_reply":"2026-09-25T09:56:07.628394Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Lấy ngẫu nhiên 20