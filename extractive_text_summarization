"source":"### Oracle","metadata":{}},{"cell_type":"code","source":"def oracle_budget(ref, syl, budget=BUDGET):\n    chosen, total, best = [], 0, 0.0\n    while True:\n        cand, cand_score = None, best\n        for i in range(len(syl)):\n            if i in chosen:\n                continue\n                \n            n = len(syl[i].split())\n            if chosen and total + n > budget * 1.2:\n                continue\n                \n            hyp = ' '.join(syl[j] for j in sorted(chosen + [i]))\n            s = scorer.score(ref, hyp)\n            v = (s['rouge1'].fmeasure + s['rouge2'].fmeasure) / 2\n            \n            if v > cand_score:\n                cand, cand_score = i, v\n                \n        if cand is None:\n            break\n            \n        chosen.append(cand)\n        total += len(syl[cand].split())\n        best = cand_score\n        \n        if total >= budget:\n            break\n    return ' '.join(syl[i] for i in sorted(chosen))\n\nora_rows = []\nfor doc_id in tqdm(data_eval):\n    ref, syl = cache[doc_id]\n    if not syl:\n        continue\n        \n    pred = oracle_budget(ref, syl)\n    s = scorer.score(ref, pred)\n    ora_rows.append({\n        'id': doc_id,\n        'oracle': pred,\n        **{f'ora_{m}': s[m].fmeasure * 100 for m in ['rouge1', 'rouge2', 'rougeL']},\n    })\n\nora_df = pd.DataFrame(ora_rows)\nprint(ora_df.filter(like='ora_').mean().round(2))\n\nora_df.to_json(os.path.join(OUTPUT, 'oracle_val.jsonl'), orient='records', lines=True, force_ascii=False)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-28T17:30:01.792955Z","iopub.execute_input":"2026-09-28T17:30:01.793408Z","iopub.status.idle":"2026-09-28T17:30:17.077174Z","shell.execute_reply.started":"2026-09-28T17:30:01.793363Z","shell.execute_reply":"2026-09-28T17:30:17.07644Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"  0%|          | 0/1999 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{