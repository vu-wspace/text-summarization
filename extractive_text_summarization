},"tags":[]},"outputs":[],"source":["import re\n","import networkx as nx\n","from tqdm.auto import tqdm\n","from underthesea import sent_tokenize\n","from rouge_score import rouge_scorer\n","from sklearn.metrics.pairwise import cosine_similarity"]},{"cell_type":"code","execution_count":7,"id":"fb37b030","metadata":{"execution":{"iopub.execute_input":"2026-09-29T01:52:09.027401Z","iopub.status.busy":"2026-09-29T01:52:09.026883Z","iopub.status.idle":"2026-09-29T01:52:09.035524Z","shell.execute_reply":"2026-09-29T01:52:09.034834Z"},"papermill":{"duration":0.018547,"end_time":"2026-09-29T01:52:09.036972+00:00","exception":false,"start_time":"2026-09-29T01:52:09.018425+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["# Đưa văn bản về dạng âm tiết\n","def to_syllable(t):\n","    return ' '.join(t.replace('_', ' ').split())\n","    \n","# Tính ROUGE, giữ dấu tiếng Việt, bỏ dấu câu\n","class WS:\n","    def tokenize(self, t):\n","        return re.findall(r'\\w+', t.lower())\n","        \n","scorer = rouge_scorer.RougeScorer(['rouge1', 'rouge2', 'rougeL'], tokenizer=WS())\n","\n","# Tách bài thành câu, bỏ câu quá ngắn\n","def split_sents(article):\n","    return [s for s in sent_tokenize(article) if len(s.split()) >= 3]\n","    \n","# Tạo bảng tóm tắt từ 3 câu đầu tiên\n","def lead_k(article, k=3):\n","    return ' '.join(split_sents(article)[:k])\n","    \n","# Chọn câu cho đến khi đủ 40 âm tiết, sắp xếp theo thứ tự gốc\n","def select_by_budget(order, sents_syl, budget=40):\n","    chosen, total = [], 0\n","    for i in order:\n","        n = len(sents_syl[i].split())\n","        if chosen and total + n > budget * 1.2:\n","            break\n","        chosen.append(i); total += n\n","        if total >= budget:\n","            break\n","    return ' '.join(sents_syl[i] for i in sorted(chosen))\n","    \n","# Chấm điểm câu bằng đồ thị + PageRank\n","def textrank(X):\n","    n = X.shape[0]\n","    sim = cosine_similarity(X)\n","    np.fill_diagonal(sim, 0)\n"