ref, syl)\n    s = scorer.score(ref, pred)\n    ora_rows.append({\n        'id': doc_id,\n        'oracle': pred,\n        **{f'ora_{m}': s[m].fmeasure * 100 for m in ['rouge1', 'rouge2', 'rougeL']},\n    })\n\nora_df = pd.DataFrame(ora_rows)\nprint(ora_df.filter(like='ora_').mean().round(2))\n\nora_df.to_json(os.path.join(out_dir, 'val_oracle.jsonl'), orient='records', lines=True, force_ascii=False)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T09:57:36.298468Z","iopub.execute_input":"2026-09-25T09:57:36.299084Z","iopub.status.idle":"2026-09-25T09:57:52.104404Z","shell.execute_reply.started":"2026-09-25T09:57:36.299043Z","shell.execute_reply":"2026-09-25T09:57:52.103687Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"merged = merged.merge(ora_df[['id'] + [f'ora_{m}' for m in ms]], on='id')\nsummary.loc['Oracle (ngân sách, trần trên)'] = [round(merged[f'ora_{m}'].mean(), 2) for m in ms]\n\nprint(summary)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T09:57:52.105349Z","iopub.execute_input":"2026-09-25T09:57:52.105555Z","iopub.status.idle":"2026-09-25T09:57:52.119181Z","shell.execute_reply.started":"2026-09-25T09:57:52.105533Z","shell.execute_reply":"2026-09-25T09:57:52.118395Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"### Output","metadata":{}},{"cell_type":"code","source":"ms = ['rouge1', 'rouge2', 'rougeL']\n\ndef load(name):\n    df = pd.read_json(os.path.join(out_dir, name), lines=True)\n    df['id'] = df['id'].astype(str)\n    return df\n\nlead_df  = load('lead_val.jsonl')\ntfidf_df = load('tfidf_val.jsonl')\npho_df   = load('val_phobert.jsonl')\nora_df   = load('val_oracle.jsonl')\n\n# Ghép theo id để mọi phương pháp dùng đúng cùng các bài\nmerged = (lead_df\n          .merge(tfidf_df.drop(columns=['abstract'], errors='ignore'), on='id')\n          .merge(pho_df, on='id')\n          .merge(ora_df, on='id'))\nprint('Số bài dùng để so sánh:', len(merged))\n\n# (tên hiển thị, tiền tố cột ROUGE, cột chứa tóm tắt)\nmethods = [\n    ('Lead-3',                          'lead3', 'lead3'),\n    ('Lead (ngân sách)',                'leadb', 'lead_budget'),\n    ('TextRank + TF-IDF (ngân sách)',   'tfidf', 'textrank_tfidf'),\n    ('TextRank + PhoBERT (ngân sách)',  'pho',   'textrank_phobert'),\n    ('Oracle (ngân sách, trần trên)',   'ora',   'oracle'),\n]\n\nrows = []\nfor name, prefix, text_col in methods:\n    rows.append({\n        'Phương pháp': name,\n        **{m.upper().replace('ROUGE', 'ROUGE-'): round(merged[f'{prefix}_{m}'].mean(), 2) for m in ms},\n        'Độ dài TB': round(merged[text_col].str.split().str.len().mean(), 1),\n    })\nrows.append({'Phương pháp': 'Sapo (tham chiếu)', 'Độ dài TB':\n             round(merged['abstract'].str.split().str.len().mean(), 1)})\n\nresults = pd.DataFrame(rows)\nprint(results.to_string(index=False))\n\nresults.to_csv(os.path.join(out_dir, 'val_extractive_results.csv'), index=False)\nprint(results.to_markdown(index=False))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T09:57:52.120203Z","iopub.execute_input":"2026-09-25T09:57:52.120964Z","iopub.status.idle":"2026-09-25T09:57:52.333197Z","shell.execute_reply.started":"2026-09-25T09:57:52.120939Z","shell.execute_reply":"2026-09-25T09:57:52.332483Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Abstractive Text Summarization","metadata":{}},{"cell_type":"markdown","source":"### VietAI/vit5-base","metadata":{}},{"cell_type":"code","source":"!pip install -q datasets sentencepiece rouge-score","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T09:57:52.334164Z","iopub.execute_input":"2026-09-25T09:57:52.334436Z","iopub.status.idle":"2026-09-25T09:57:55.873646Z","shell.execute_reply.started":"2026-09-25T09:57:52.33441Z","shell.execute_reply":"2026-09-25T09:57:55.872776Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import os, re, json, random\nimport numpy as np, pandas as pd, torch, transformers\nfrom tqdm.auto import tqdm\nfrom datasets import Dataset\nfrom rouge_score import rouge_scorer\nfrom transformers import (AutoTokenizer, AutoModelForSeq2SeqLM, DataCollatorForSeq2Seq,\n                          Seq2SeqTrainingArguments, Seq2SeqTrainer)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T09:57:55.875273Z","iopub.execute_input":"2026-09-25T09:57:55.876034Z","iopub.status.idle":"2026-09-25T09:57:58.152057Z","shell.execute_reply.started":"2026-09-25T09:57:55.876001Z","shell.execute_reply":"2026-09-25T09:57:58.151429Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Cấu hình\nOUT_DIR      = '/kaggle/working'\nMODEL_NAME   = 'VietAI/vit5-base'\nTAG          = 'vit5'\nCKPT_DIR     = os.path.join(OUT_DIR, f'{TAG}_ckpt')\nBEST_DIR     = os.path.join(OUT_DIR, f'{TAG}_best')\nMAX_SOURCE   = 512\nMAX_TRAIN    = 30000\nN_DEV        = 300\nBATCH, ACCUM = 2, 16\nLR, EPOCHS   = 3e-4, 3\nSEED         = 42\nrandom.seed(SEED); np.random.seed(SEED); torch.manual_seed(SEED)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T09:57:58.152931Z","iopub.execute_input":"2026-09-25T09:57:58.153897Z","iopub.status.idle":"2026-09-25T09:57:58.164669Z","shell.execute_reply.started":"2026-09-25T09:57:58.153868Z","shell.execute_reply":"2026-09-25T09:57:58.163696Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"!pip install -q \"transformers==4.46.3\" \"accelerate==1.1.1\" sentencepiece","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T09:57:58.165687Z","iopub.execute_input":"2026-09-25T09:57:58.16599Z","iopub.status.idle":"2026-09-25T09:58:01.76234Z","shell.execute_reply.started":"2026-09-25T09:57:58.165952Z","shell.execute_reply":"2026-09-25T09:58:01.76149Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Hàm dùng chung\ndef to_syllable(t):\n    return ' '.join(t.replace('_', ' ').split())\n \nclass WS:\n    def tokenize(self, t):\n        return re.findall(r'\\w+', t.lower())\n \nscorer = rouge_scorer.RougeScorer(['rouge1', 'rouge2', 'rougeL'], tokenizer=WS())\n \ndef rouge(ref, pred):\n    s = scorer.score(to_syllable(ref), to_syllable(pred))\n    return {m: s[m].fmeasure * 100 for m in ['rouge1', 'rouge2', 'rougeL']}","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T09:58:01.763686Z","iopub.execute_input":"2026-09-25T09:58:01.764097Z","iopub.status.idle":"2026-09-25T09:58:01.770163Z","shell.execute_reply.started":"2026-09-25T09:58:01.764064Z","shell.execute_reply":"2026-09-25T09:58:01.769516Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Đọc dữ liệu -> Dataset (dạng âm tiết, KHÔNG có '_')\ndef read_json(name):\n    with open(os.path.join(OUT_DIR, f'{name}.json'), encoding='utf-8') as f:\n        return json.load(f)\n \ndef to_dataset(data, keys):\n    return Dataset.from_list([{'id': k,\n                               'document': to_syllable(data[k]['article']),\n                               'summary':  to_syllable(data[k]['abstract'])} for k in keys])\n \ntrain_data, val_data = read_json('train'), read_json('val')\neval_ids = json.load(open(os.path.join(OUT_DIR, 'eval_ids.json')))\n \ntrain_keys = sorted(train_data.keys())\nif MAX_TRAIN:\n    train_keys = random.Random(SEED).sample(train_keys, min(MAX_TRAIN, len(train_keys)))\ndev_keys = random.Random(SEED).sample(sorted(set(val_data) - set(eval_ids)), N_DEV)\n \ntrain_ds = to_dataset(train_data, train_keys)\ndev_ds   = to_dataset(val_data, dev_keys)\ndel train_data\n\nprint(train_ds, dev_ds)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T09:58:01.771335Z","iopub.execute_input":"2026-09-25T09:58:01.771539Z","iopub.status.idle":"2026-09-25T09:58:10.058123Z","shell.execute_reply.started":"2026-09-25T09:58:01.771518Z","shell.execute_reply":"2026-09-25T09:58:10.057232Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Chọn độ dài token từ TẬP TRAIN\ntokenizer = AutoTokenizer.from_pretrained(MODEL_NAME, use_fast=False)\nsample = train_ds.shuffle(seed=SEED).select(range(min(3000, len(train_ds))))\nsrc_len = np.array([len(tokenizer(x).input_ids) for x in sample['document']])\ntgt_len = np.array([len(tokenizer(x).input_ids) for x in sample['summary']])\n\nprint(f'Bài : trung vị {np.median(src_len):.0f} token, bị cắt ở {MAX_SOURCE}: {(src_len > MAX_SOURCE).mean():.1%}')\nprint(f'Sapo: trung vị {np.median(tgt_len):.0f} token, P95 {np.percentile(tgt_len, 95):.0f}')\n\nMAX_TARGET = int(np.percentile(tgt_len, 95)) + 8\nprint('MAX_TARGET =', MAX_TARGET)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T09:58:10.059318Z","iopub.execute_input":"2026-09-25T09:58:10.060122Z","iopub.status.idle":"2026-09-25T09:58:19.253118Z","shell.execute_reply.started":"2026-09-25T09:58:10.06009Z","shell.execute_reply":"2026-09-25T09:58:19.252392Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Tokenize\ndef preprocess(batch):\n    enc = tokenizer(batch['document'], max_length=MAX_SOURCE, truncation=True)\n    enc['labels'] = tokenizer(text_target=batch['summary'], max_length=MAX_TARGET,\n                              truncation=True)['input_ids']\n    return enc\n \ntrain_tok = train_ds.map(preprocess, batched=True, remove_columns=train_ds.column_names)\ndev_tok   = dev_ds.map(preprocess,   batched=True, remove_columns=dev_ds.column_names)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T09:58:19.25432Z","iopub.execute_input":"2026-09-25T09:58:19.254789Z","iopub.status.idle":"2026-09-25T09:59:45.934952Z","shell.execute_reply.started":"2026-09-25T09:58:19.254703Z","shell.execute_reply":"2026-09-25T09:59:45.934272Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Model + Trainer\nmodel = AutoModelForSeq2SeqLM.from_pretrained(MODEL_NAME)\nmodel.config.use_cache = False\ngc = model.generation_config\ngc.max_new_tokens, gc.num_beams, gc.no_repeat_ngram_size, gc.early_stopping = MAX_TARGET, 4, 3, True\n \ndef compute_metrics(eval_pred):\n    preds, labels = eval_pred\n    preds  = np.where(preds  != -100, preds,  tokenizer.pad_token_id)\n    labels = np.where(labels != -100, labels, tokenizer.pad_token_id)\n    dp = tokenizer.batch_decode(preds,  skip_special_tokens=True)\n    dl = tokenizer.batch_decode(labels, skip_special_tokens=True)\n    scores = pd.DataFrame([rouge(l, p) for l, p in zip(dl, dp)]).mean()\n    out = {m: round(float(v), 2) for m, v in scores.items()}\n    out['gen_len'] = float(np.mean([len(to_syllable(p).split()) for p in dp]))\n    return out\n \n# T5 dễ NaN với fp16: chỉ bf16 nếu GPU hỗ trợ, còn lại fp32 (T4, P100 của Kaggle)\nuse_bf16 = torch.cuda.is_available() and torch.cuda.is_bf16_supported()\nsteps_per_epoch = max(len(train_tok) // (BATCH * ACCUM), 1)\ntotal_steps = steps_per_epoch * EPOCHS\neval_every = max(steps_per_epoch // 2, 50)\n \nargs = Seq2SeqTrainingArguments(\n    output_dir=CKPT_DIR,\n    per_device_train_batch_size=BATCH,\n    per_device_eval_batch_size=8,\n    gradient_accumulation_steps=ACCUM,\n    learning_rate=LR,\n    num_train_epochs=EPOCHS,\n    warmup_steps=int(0.05 * total_steps),\n    weight_decay=0.01,\n    lr_scheduler_type='linear',\n    eval_strategy='steps', eval_steps=eval_every,\n    save_strategy='steps', save_steps=eval_every, save_total_limit=2,\n    load_best_model_at_end=True, metric_for_best_model='rougeL', greater_is_better=True,\n    predict_with_generate=True,\n    bf16=use_bf16, fp16=False,\n    gradient_checkpointing=True,\n    logging_steps=50,\n    report_to='none',\n    seed=SEED,\n)\n \ntrainer = Seq2SeqTrainer(\n    model=model, args=args,\n    train_dataset=train_tok, eval_dataset=dev_tok,\n    data_collator=DataCollatorForSeq2Seq(tokenizer, model=model),\n    processing_class=tokenizer,          # transformers cũ hơn 4.46: đổi thành tokenizer=tokenizer\n    compute_metrics=compute_metrics,\n)\n\nprint(f'{steps_per_epoch} bước/epoch, tổng {total_steps} bước, đánh giá mỗi {eval_every} bước')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T09:59:45.936091Z","iopub.execute_input":"2026-09-25T09:59:45.936419Z","iopub.status.idle":"2026-09-25T10:00:06.446105Z","shell.execute_reply.started":"2026-09-25T09:59:45.936392Z","shell.execute_reply":"2026-09-25T10:00:06.445328Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Train (tự tiếp tục nếu đã có checkpoint từ phiên trước)\nhas_ckpt = os.path.isdir(CKPT_DIR) and any(d.startswith('checkpoint-') for d in os.listdir(CKPT_DIR))\ntrainer.train(resume_from_checkpoint=True if has_ckpt else None)\ntrainer.save_model(BEST_DIR)\ntokenizer.save_pretrained(BEST_DIR)\n\nprint('Checkpoint tốt nhất:', trainer.state.best_model_checkpoint)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T10:00:06.447053Z","iopub.execute_input":"2026-09-25T10:00:06.447374Z","iopub.status.idle":"2026-09-25T10:27:19.638287Z","shell.execute_reply.started":"2026-09-25T10:00:06.447347Z","shell.execute_reply":"2026-09-25T10:27:19.63708Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Đánh giá trên 2000 bài eval_ids\nmodel = AutoModelForSeq2SeqLM.from_pretrained(BEST_DIR).to('cuda').eval()\n \n@torch.no_grad()\ndef summarize(texts, bs=16):\n    outs = []\n    for i in tqdm(range(0, len(texts), bs), desc='Sinh tóm tắt'):\n        enc = tokenizer(texts[i:i + bs], max_length=MAX_SOURCE, truncation=True,\n                        padding=True, return_tensors='pt').to('cuda')\n        gen = model.generate(**enc, max_new_tokens=MAX_TARGET, num_beams=4,\n                             no_repeat_ngram_size=3, early_stopping=True)\n        outs.extend(tokenizer.batch_decode(gen, skip_special_tokens=True))\n    return outs\n \ndef evaluate(split, data, keys):\n    ds = to_dataset(data, keys)\n    preds = summarize(ds['document'])\n    rows = [{'id': i, TAG: to_syllab